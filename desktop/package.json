{
  "name": "sub-browser",
  "version": "1.0.0",
  "description": "SUB-BROWSER \u2014 a dark-themed desktop browser built on Electron/Chromium with a dragon-blue accent.",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoketest.js",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.subbrowser.app",
    "productName": "SUB-BROWSER",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}